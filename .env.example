# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: run `npm run db:local` (embedded PostgreSQL on port 54329).
# Production: your managed PostgreSQL URL (Neon, Supabase, Railway, RDS…),
# ideally the pooled connection string, with sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/ggz_dev"

# Public base URL of the site, no trailing slash. Used for Flutterwave redirect
# URLs, recovery links in emails and metadata. e.g. https://camp.godsgenz.org
APP_URL="http://localhost:3000"

# Server-side secret used to HMAC IP addresses for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET="replace-with-a-long-random-string"

# ─── Flutterwave ─────────────────────────────────────────────────────────────
# Flutterwave → Settings → API Keys. Use the TEST secret key (FLWSECK_TEST-…)
# for development and the LIVE key (FLWSECK-…) only in production.
# Server-side only — never prefix it with NEXT_PUBLIC_. No public key is
# needed: checkout uses Flutterwave's hosted payment page.
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-replace-me"

# Flutterwave → Settings → Webhooks → "Secret hash". Choose a long random value,
# paste it there AND here. Webhooks without a matching verif-hash header are rejected.
FLUTTERWAVE_WEBHOOK_HASH="replace-with-your-webhook-secret-hash"

# Optional. Only for automated tests: points the server at the local mock
# Flutterwave server. Ignored unless the secret key starts with FLWSECK_TEST-.
# FLUTTERWAVE_API_BASE_URL="http://localhost:4010"

# ─── Email (strongly recommended) ───────────────────────────────────────────
# Without email, confirmations and secure recovery links are not sent; admins
# can still issue recovery links from the dashboard. Pick ONE option.
#
# Option A — a normal mailbox over SMTP (no domain needed). For Gmail:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use it below (spaces are fine). Never use the normal Gmail password.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="yourmailbox@gmail.com"
# SMTP_PASS="abcd efgh ijkl mnop"
# EMAIL_FROM="GGZ Camp <yourmailbox@gmail.com>"
#
# Option B — Resend (requires a domain you own, verified in Resend).
# RESEND_API_KEY="re_…"
# EMAIL_FROM="GGZ Camp <camp@yourdomain.org>"

# ─── Scheduled reconciliation (optional) ────────────────────────────────────
# Protects /api/cron/reconcile (Vercel Cron sends it as a Bearer token).
# CRON_SECRET="replace-with-a-long-random-string"
